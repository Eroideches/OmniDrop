# Maintainer: Eroideches <180309617+Eroideches@users.noreply.github.com>
# Arch Linux package for the prebuilt OmniDrop release (generated by scripts/package-linux.sh).
# Usage: download this PKGBUILD from the GitHub release, then `makepkg -si`.
pkgname=omnidrop-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Fast, end-to-end encrypted P2P file transfer for Android, Windows and Linux"
arch=('x86_64')
url="https://github.com/Eroideches/OmniDrop"
license=('MIT')
depends=('gtk3' 'glib2' 'glibc' 'gcc-libs')
optdepends=('networkmanager: Wi-Fi Direct links'
            'bluez: Bluetooth LE discovery'
            'xdg-utils: open received files')
provides=('omnidrop')
conflicts=('omnidrop')
source=("omnidrop-linux-x64-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/omnidrop-linux-x64.tar.gz")
sha256sums=('@SHA256@')

package() {
  install -d "${pkgdir}/opt/omnidrop" "${pkgdir}/usr/bin"
  cp -a "${srcdir}/omnidrop/." "${pkgdir}/opt/omnidrop/"
  rm -rf "${pkgdir}/opt/omnidrop/share" "${pkgdir}/opt/omnidrop/install.sh"
  ln -s /opt/omnidrop/omnidrop "${pkgdir}/usr/bin/omnidrop"
  install -Dm644 "${srcdir}/omnidrop/share/com.eroideches.omnidrop.desktop" \
    "${pkgdir}/usr/share/applications/com.eroideches.omnidrop.desktop"
  cp -a "${srcdir}/omnidrop/share/icons" "${pkgdir}/usr/share/"
  install -Dm644 "${srcdir}/omnidrop/share/polkit/50-omnidrop-networkmanager.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/50-omnidrop-networkmanager.rules"
  install -Dm644 "${srcdir}/omnidrop/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
